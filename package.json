{
  "name": "opsportal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:worker": "npm run build && wrangler dev",
    "build": "next build",
    "start": "wrangler dev",
    "lint": "eslint src worker",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "cf:types": "wrangler types",
    "deploy": "npm run build && wrangler deploy --minify",
    "verify": "npm run lint && npm run typecheck:worker && npm test && npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.7.0",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-window": "^1.8.11",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "^0.35.5",
    "undici": "^7.30.0"
  }
}
