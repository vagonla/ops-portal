{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "worker/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
