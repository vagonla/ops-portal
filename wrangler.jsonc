{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ops-portal",
  "main": "worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  }
}
